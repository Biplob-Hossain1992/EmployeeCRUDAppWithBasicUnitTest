@{
    ViewData["Title"] = "Employee";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="row align-items-center">
                            <div class="col">
                                <h4 class="card-title no-print">Employee List </h4>
                            </div>
                            <div class="col-auto">
                                <button type="button" data-bs-toggle="modal" id="btnNew" class="btn btn-success">Add New</button>
                            </div>
                        </div>
                        <div class="col-md-8" style="text-align: center; margin: 0px; padding: 0px;">
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-2">
                                <div class="form-group">
                                    <input type="text" class="form-control" autocomplete="off" id="searchName" placeholder="Search by name">
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <select id="searchDepartmentId" name="searchDepartmentId" class="form-control select2Body departmentId"></select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <input type="text" class="form-control" autocomplete="off" id="searchPosition" placeholder="Search by position">
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <input type="text" class="form-control" autocomplete="off" id="searchScore" placeholder="Search with range ex: 1-10">
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <button type="button" data-bs-toggle="modal" id="btnSearch" class="btn btn-success">Search</button>
                                </div>
                            </div>
                        </div>
                        <table id="EmployeeList" class="table table-hover table-bordered">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Phone</th>
                                    <th>Department</th>
                                    <th>Position</th>
                                    <th class="text-center">Join Date</th>
                                    <th class="text-center">Review Score</th>
                                    <th></th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<div class="modal fade" id="modalEmployeeCreate" role="dialog" data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title m-0" id="modalTitle">Add Employee</h6>
                <button type="button" class="btn-close" data-dismiss="modal" aria-label="Close">&times;</button>
            </div>
            <div class="modal-body">
                <div class="card-body">
                    <form id="frmEmployeeCreate" enctype="multipart/form-data">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <input type="hidden" id="id" />
                                    <label for="name">Name</label>
                                    <input type="text" class="form-control" autocomplete="off" id="name" name="name" placeholder="Enter Employee Name" oninput="this.value = this.value.replace(/[^a-zA-Z0-9. ]/, '')">
                                </div>
                                <div class="form-group">
                                    <label for="email">Email</label>
                                    <input type="email" class="form-control" autocomplete="off" id="email" name="email" placeholder="Enter Employee Email">
                                </div>
                                <div class="form-group">
                                    <label for="phone">Phone</label>
                                    <input type="text" class="form-control phone" autocomplete="off" id="phone" name="phone" placeholder="Enter Employee Phone">
                                </div>
                                <div class="form-group">
                                    <label for="status">Status</label>
                                    <select id="status" name="status" class="form-control">
                                        <option value="1" selected>Active</option>
                                        <option value="0">InActive</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="departmentId">Department</label>
                                    <select id="departmentId" name="departmentId" class="form-control select2Modal departmentId"></select>
                                </div>
                                <div class="form-group">
                                    <label for="position">Position</label>
                                    <input type="text" class="form-control" autocomplete="off" id="position" name="position" placeholder="Enter Employee Position">
                                </div>
                                <div class="form-group">
                                    <label for="joinDate">Join Date</label>
                                    <input type="text" class="form-control datepicker" autocomplete="off" id="joinDate" name="joinDate" placeholder="Enter Join date">
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-success btn-sm" id="btnSave">Save Changes</button>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script type="text/javascript">
        (() => {
            $("#frmEmployeeCreate").validate({
                rules: {
                    name: { required: true },
                    email: { required: true },
                    phone: { required: true },
                    departmentId: { required: true },
                    position: { required: true },
                    joinDate: { required: true }
                },
                messages: {
                    name: 'Name is required',
                    email: 'Email is required',
                    phone: 'Phone is required',
                    departmentId: 'Department is required',
                    position: 'Position is required',
                    joinDate: 'Join Date is required'
                },
                errorElement: 'span',
                errorPlacement: function (error, element) {
                    error.addClass('invalid-feedback');
                    element.closest('.form-group').append(error);
                },
                highlight: function (element, errorClass, validClass) {
                    $(element).addClass('is-invalid');
                },
                unhighlight: function (element, errorClass, validClass) {
                    $(element).removeClass('is-invalid');
                }
            });
            getAllDepartment();
        })()

        $("#btnNew").click(function () {
            $("#modalEmployeeCreate #modalTitle").text("Create Employee");
            $("#modalEmployeeCreate #btnSave").text("Save Changes");
            $("#frmEmployeeCreate").trigger("reset");
            $('.select2Modal').val('').trigger('change');
            $("#modalEmployeeCreate").modal('show');
        });

        function getAllDepartment() {
            return $.ajax({
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json'
                },
                url: baseURL + '/api/Department/GetAllDepartment',
                dataType: "json",
                type: 'get',
                success: function (res) {
                    $(".departmentId").empty();
                    let option = `<option value="">Select...</option>`;
                    $.each(res, function (key, val) {
                        option += `<option value="${val.id}">${val.departmentName}</option>`;
                    });
                    $(".departmentId").append(option);
                }
            });
        }
        $(document).on("click", "#btnSave", function () {
            if ($("#frmEmployeeCreate").valid()) {
                var requestBody = {
                    name: $("#name").val(),
                    email: $("#email").val(),
                    phone: $("#phone").val(),
                    departmentId: +$("#departmentId").val(),
                    position: $("#position").val(),
                    formatedDate: $("#joinDate").val(),
                    status: $("#status").val() == "1" ? true : false
                };
                let url = '/api/Employee/CreateEmployee';
                let btnText = $(this).text();
                if (btnText == "Update Changes"){
                    url = '/api/Employee/UpdateEmployee';
                    requestBody.id = +$("#id").val();
                }
                $.ajax({
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json'
                    },
                    url: baseURL + url,
                    dataType: 'json',
                    data: JSON.stringify(requestBody),
                    type: 'post',
                    success: function (res) {
                        if(res.type == "Success"){
                            toastr.success(res.message, res.type);
                            $("#frmEmployeeCreate").trigger("reset");
                            $('.select2Modal').val('').trigger('change');
                            $("#modalEmployeeCreate").modal('hide');
                            dataTable.fnFilter();
                        }else{
                            toastr.error(res.message, res.type);
                        }
                        $("#btnSave").prop("disabled", false);
                    },
                    error: function (request, status, error) {
                        $("#btnSave").prop("disabled", false);
                    }
                });
            }
        });
        var dataTable = $("#EmployeeList").dataTable({
            "processing": true,
            "serverSide": true,
            "filter": true,
            "pageLength": 10,
            "autoWidth": false,
            "lengthMenu": [[10, 50, 100, 999999999], [10, 50, 100, "All"]],
            "order": [[0, "desc"]],
            "ajax": {
                "url": baseURL + '/api/Employee/GetAllEmployee',
                "type": "POST",
                "data": function (data) {
                    data.name = $("#searchName").val();
                    data.departmentId = $("#searchDepartmentId").val();
                    data.position = $("#searchPosition").val();
                    let value = $("#searchScore").val();
                    if (value.includes('-') && value.split('-').length > 1){
                        data.score = $("#searchScore").val();
                    }                    
                }
            },
            "columns": [
                { 
                    "data": null, "name": null, "orderable": false, "render": function (data, type, full, meta) { 
                        return `<td>${full.name}</td>`; 
                    } 
                },
                {
                    "data": null, "name": null, "orderable": false, "render": function (data, type, full, meta) {
                        return `<td>${full.email}</td>`;
                    }
                },
                {
                    "data": null, "name": null, "orderable": false, "render": function (data, type, full, meta) {
                        return `<td>${full.phone}</td>`;
                    }
                },
                {
                    "data": null, "name": null, "orderable": false, "render": function (data, type, full, meta) {
                        return `<td>${full.departmentName}</td>`;
                    }
                },
                {
                    "data": null, "name": null, "orderable": false, "render": function (data, type, full, meta) {
                        return `<td>${full.position}</td>`;
                    }
                },
                {
                    "data": null, "name": null, "orderable": false, "render": function (data, type, full, meta) {
                        return `<td><p style="text-align:center">${full.formatedDate}</p></td>`;
                    }
                },
                {
                    "data": null, "name": null, "orderable": false, "render": function (data, type, full, meta) {
                        return `<td><p style="text-align:center">${full.reviewScore}</p></td>`;
                    }
                },
                {
                    "data": "Null", "orderable": false,
                    "render": function (data, type, full, meta) {
                        if(full.deleted){
                            return `<td><p style="color: indianred;text-align:center">Deleted</p></td>`
                        }else{
                            return `<td><p style="text-align:center">
                                        <i class="fa fa-edit edit" data-id="${full.id}" style="cursor:pointer;"></i>
                                        <i class="fa fa-trash delete" data-id="${full.id}" style="cursor:pointer;color:red"></i>
                                    </p></td>`
                        }                        
                    }
                }
            ]
        });

        $(document).on("click", "#btnSearch", function(e){
            dataTable.fnFilter();
        });

        $(document).on("click", ".edit", function (e) {
            e.preventDefault();
            let id = $(this).data('id');
            $("#id").val(id);
            $.ajax({
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json'
                },
                url: baseURL + '/api/Employee/GetEmployeeById',
                data:{ id },
                dataType: "json",
                type: 'get',
                success: function (res) {
                    $("#name").val(res.name);
                    $("#email").val(res.email);
                    $("#phone").val(res.phone);
                    $("#position").val(res.position);
                    $("#joinDate").val(res.formatedDate);
                    $("#status").val(res.status == false ? '0':'1').trigger('change');
                    $.when(
                        getAllDepartment()
                    ).done(function () {
                        $("#departmentId").val(res.departmentId).trigger('change');
                    });
                    $("#modalEmployeeCreate #modalTitle").text("Update Employee");
                    $("#modalEmployeeCreate #btnSave").text("Update Changes");
                    $("#modalEmployeeCreate").modal('show');
                }
            });
        });
        $(document).on("click", ".delete", function (e) {
            e.preventDefault();
            var id = $(this).data('id');
            $.confirm({
                title: 'Delete Confirmation!',
                content: 'Are you sure want to delete this?',
                type: 'red',
                typeAnimated: true,
                buttons: {
                    tryAgain: {
                        text: 'Delete',
                        btnClass: 'btn-red',
                        action: function () {
                            $.ajax({
                                headers: {
                                    'Accept': 'application/json',
                                    'Content-Type': 'application/json'
                                },
                                url: baseURL + '/api/Employee/RemoveEmployee?id=' + id,
                                dataType: "json",
                                type: 'delete',
                                success: function (flag) {
                                    if (flag == true) {
                                        $.confirm({
                                            title: 'Confirmation!',
                                            content: 'Record has been deleted successfully!',
                                            type: 'green',
                                            buttons: {
                                                somethingElse: {
                                                    text: 'Ok',
                                                    btnClass: 'btn-blue',
                                                    keys: ['enter'],
                                                    action: function () {}
                                                }
                                            }
                                        });
                                        dataTable.fnFilter();
                                    }
                                },
                                error: function (xhr) {
                                    console.log(xhr);
                                }
                            });
                        }
                    },
                    close: function () {
                    }
                }
            });
        });
    </script>
}